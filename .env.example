# ============================
# TIKTOK API
# ============================
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token
TIKTOK_APP_ID=your_tiktok_app_id

# ============================
# MINIMAX (Generación de Video)
# ============================
MINIMAX_API_KEY=your_minimax_api_key
MINIMAX_API_URL=https://api.minimax.chat/v1

# ============================
# OPENAI (Agente LangGraph)
# ============================
OPENAI_API_KEY=your_openai_key

# ============================
# BASE DE DATOS
# ============================
DATABASE_URL=postgresql://postgres:password@localhost:5432/armaterra
REDIS_URL=redis://localhost:6379

# ============================
# LANGFUSE (Observabilidad)
# ============================
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_HOST=http://localhost:3000

# ============================
# LINK BI / MALL BI
# ============================
LINK_BI_API_KEY=your_link_bi_key
LINK_BI_API_URL=https://api.link.bi/v1

# ============================
# N8N WEBHOOK
# ============================
N8N_WEBHOOK_URL=http://localhost:5678/webhook
